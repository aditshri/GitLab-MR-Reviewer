# GitLab instance URL used for merge request access.
GITLAB_URL=https://gitlab.com

# Access token used to authenticate with GitLab.
GITLAB_TOKEN=

# GitHub PAT with models:read scope for GitHub Models API requests.
GITHUB_MODELS_TOKEN=

# OpenAI-compatible GitHub Models API endpoint and model.
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Directory containing canonical review rule sets.
RULES_DIRECTORY=review_rules

# Flask secret used for session and application signing.
FLASK_SECRET_KEY=

# Enable Flask debug behavior locally when needed.
FLASK_DEBUG=False

# Flask bind address and port.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
